# 복사해서 .env 로 저장
DATABASE_URL=postgresql://finvesting:finvesting@localhost:5432/finvesting

# 단일 사용자 모드 (서비스화 시 인증으로 대체)
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001

# AI (개발: Ollama 로컬 / 추후: 맥스튜디오 Ollama, DGX Spark vLLM, 클라우드)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b         # 맥북: gemma4:12b 또는 exaone3.5:7.8b(한국어 특화). 대형 모델은 맥스튜디오에서
OLLAMA_EMBED_MODEL=nomic-embed-text

# 데이터 수집
WORKER_RUN_ON_START=true # worker 기동 시 모든 소스 즉시 1회 수집
ECOS_API_KEY=            # 한국은행 ECOS (금리·환율·물가)
FRED_API_KEY=            # 미국 FRED (연준금리·CPI·국채·달러지수·VIX)
NAVER_CLIENT_ID=         # 네이버 뉴스 검색 API
NAVER_CLIENT_SECRET=
KIS_APP_KEY=             # 한국투자증권 Open API (시세)
KIS_APP_SECRET=
DART_API_KEY=            # 금감원 DART (한국 재무제표) https://opendart.fss.or.kr
DART_TARGETS=            # 예: 005930:00126380:삼성전자,000660:00164779:SK하이닉스  (종목코드:corp_code:이름)
SEC_USER_AGENT=          # SEC EDGAR 필수: "앱이름 이메일" 형식
EDGAR_TARGETS=           # 예: AAPL:0000320193,MSFT:0000789019  (티커:CIK)
YAHOO_GAP_MS=1500        # 야후 종목 간 요청 간격(ms), 429 나면 늘릴 것
YAHOO_TARGETS=           # 예: AAPL,MSFT,SPY,QQQ,^GSPC,^IXIC

# 모바일이 접속할 웹 API 주소 (같은 Wi-Fi의 맥북 IP)
EXPO_PUBLIC_API_URL=http://localhost:3000
