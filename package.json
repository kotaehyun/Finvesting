{
  "name": "finvesting",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @finvesting/web dev",
    "dev:worker": "pnpm --filter @finvesting/worker dev",
    "dev:mobile": "pnpm --filter @finvesting/mobile start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @finvesting/db generate",
    "db:migrate": "pnpm --filter @finvesting/db migrate",
    "db:studio": "pnpm --filter @finvesting/db studio"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
